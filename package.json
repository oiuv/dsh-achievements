{
  "name": "@local/dsh-achievements",
  "version": "0.2.0",
  "type": "module",
  "description": "Accurate session statistics and capability-based achievements for DeepSeek Harness",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/engine.js",
    "src/events.js",
    "src/collector.js",
    "src/catalog.js",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "meta": {
    "title": "DSH Achievement Hall",
    "description": "Session statistics and achievements"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
